# Add actual values only to CloudBase environment variables, never to this file.
SPORTRADAR_API_KEY=
SPORTRADAR_WORLD_CUP_SEASON_ID=
SPORTRADAR_WORLD_CUP_COMPETITION_ID=
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_LANGUAGE_CODE=en
# Default protects the usual trial 1 QPS limit within a warm instance.
SPORTRADAR_REQUEST_INTERVAL_MS=1100
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Required for shared AI unless public access is explicitly enabled.
# Generate privately; enter the same value in the product's AI access settings.
AI_ACCESS_TOKEN=
AI_ALLOW_PUBLIC=false
# Per warm instance, not an account-wide budget or distributed rate limiter.
AI_MAX_CONCURRENT=2
AI_MAX_HOURLY_CALLS=60
AI_MAX_DAILY_CALLS=200
TAVILY_API_KEY=
TOPHUBDATA_API_KEY=
REDFOX_API_KEY=
REDFOX_XHS_CATEGORY=体育锻炼
# Optional: otherwise uses yesterday in Asia/Shanghai.
REDFOX_XHS_RANK_DATE=
# Optional DailyHot deployment URL; must use HTTPS.
DAILY_HOT_API_BASE=https://nicee-wine.vercel.app
# Per provider, per warm function instance; not an account-wide spending cap.
HOT_SEARCH_REQUESTS_PER_MINUTE=20
