# Copy this file to .env.runtime on the server.
# Never commit the real .env.runtime file.

NODE_ENV=production

# Optional: live World Cup data. Leave blank to use the project's built-in fallbacks.
SPORTRADAR_API_KEY=
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_LANGUAGE_CODE=en
SPORTRADAR_BASE_URL=
SPORTRADAR_EXTENDED_BASE_URL=
SPORTRADAR_WORLD_CUP_COMPETITION_ID=
SPORTRADAR_WORLD_CUP_SEASON_ID=
SPORTRADAR_TIMEOUT_MS=5000
WORLD_CUP_FREE_SOURCE_TIMEOUT_MS=5000

# Optional: AI-enhanced content generation.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_QUALITY=deepseek-v4-flash

# Optional: hot-topic sources.
TOPHUBDATA_API_KEY=
TOPHUBDATA_BASE_URL=https://api.tophubdata.com
TOPHUBDATA_NODE_HASHIDS=
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
DAILY_HOT_API_BASE=https://nicee-wine.vercel.app
DAILY_HOT_PLATFORMS=weibo,douyin,bilibili,baidu,zhihu,hupu
UAPIPRO_API_KEY=
UAPIPRO_BASE_URL=https://uapis.cn/api/v1
UAPIPRO_HOT_ENDPOINT=/misc/hotboard
REDFOX_API_KEY=
REDFOX_XHS_CATEGORY=体育锻炼
REDFOX_XHS_RANK_DATE=
XHS_HOT_API_URL=
XHS_HOT_API_KEY=

NEXT_PUBLIC_USE_MOCK=false
